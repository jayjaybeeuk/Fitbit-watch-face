{
  "name": "modern-fitbit-watch-face",
  "version": "1.0.0",
  "description": "A modern dark-themed digital watch face for Fitbit Versa 3 and Sense",
  "private": true,
  "license": "MIT",
  "devDependencies": {
    "@fitbit/sdk": "^6.1.0",
    "@fitbit/sdk-cli": "^1.7.3",
    "fitbit-sdk-types": "^7.0.0"
  },
  "fitbit": {
    "appUUID": "f96dc2ec-85c9-43df-9ca4-804f32b48f04",
